# Source Translator - Environment Variables
# Copy this file to .env and fill in your values

# GitHub Personal Access Token (for package publishing)
# Generate at: https://github.com/settings/tokens
GITHUB_API_TOKEN=

# Admin panel key
ST_ADMIN_KEY=9b44a78a8dd4972f0e7e7d3be86fe274

# Database (optional)
DATABASE_URL=postgres://postgres:password@localhost/source_translator

# Redis (optional)
REDIS_URL=redis://127.0.0.1/

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Logging
RUST_LOG=info
