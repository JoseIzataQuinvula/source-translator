# Source Translator - Environment Variables
# Copy this file to .env and fill in your values

# GitHub Personal Access Token (for package publishing)
GITHUB_API_TOKEN=

# Admin credentials (root access)
ST_ROOT_USER=quinvula
ST_ROOT_PASS_HASH=

# Regular user credentials
ST_USER_USER=
ST_USER_PASS_HASH=

# Admin panel key (for web access)
ST_ADMIN_KEY=

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Logging
RUST_LOG=info
