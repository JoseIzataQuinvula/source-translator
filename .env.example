# Source Translator - Environment Variables
# Copy this file to .env and fill in your values

# GitHub Personal Access Token (for package publishing)
# Generate at: https://github.com/settings/tokens
GITHUB_API_TOKEN=

# Admin panel key (generate your own)
ST_ADMIN_KEY=

# Database (optional)
DATABASE_URL=

# Redis (optional)
REDIS_URL=

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Logging
RUST_LOG=info
